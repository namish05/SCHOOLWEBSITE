# Copy this file to .env and fill in your own values.

# Local MongoDB:   mongodb://127.0.0.1:27017/hillwoods-academy
# MongoDB Atlas:   mongodb+srv://<user>:<password>@<cluster>.mongodb.net/hillwoods-academy
MONGODB_URI=mongodb://127.0.0.1:27017/hillwoods-academy

PORT=4000

# The URL your frontend (Vite) runs on, so the API accepts requests from it.
CLIENT_ORIGIN=http://localhost:3000

# Simple shared password for the /admin.html inbox view. Change this.
ADMIN_KEY=change-me
